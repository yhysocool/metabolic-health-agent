# 应用
MHA_APP_NAME=Metabolic Health Agent
MHA_ENVIRONMENT=development
MHA_API_PREFIX=/api
MHA_LOG_LEVEL=INFO
MHA_CORS_ORIGINS=["https://localhost","http://localhost","capacitor://localhost","http://localhost:3000","http://localhost:5173"]

# 默认使用本地合成演示数据与内存仓储；Docker Compose 会覆盖为 sqlalchemy。
MHA_REPOSITORY_BACKEND=memory
MHA_SEED_SYNTHETIC_DATA=true
MHA_DEMO_USER_ID=00000000-0000-0000-0000-000000000001

# 手机通过同一局域网访问时，可启用下面仅匹配私有网段的开发 CORS 规则。
# 不要把该规则直接用于公网生产环境。
MHA_CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1|10\.[0-9]+\.[0-9]+\.[0-9]+|192\.168\.[0-9]+\.[0-9]+|172\.(1[6-9]|2[0-9]|3[01])\.[0-9]+\.[0-9]+)(:[0-9]+)?$

# PostgreSQL
MHA_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/metabolic_health
POSTGRES_DB=metabolic_health
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# LLM 仅预留配置，当前 Provider 不会发起真实网络请求。
MHA_LLM_PROVIDER=local
MHA_DEEPSEEK_API_KEY=
MHA_QWEN_API_KEY=
MHA_LOCAL_LLM_BASE_URL=http://localhost:11434

# Agent / RAG
MHA_HEALTH_LOOKBACK_DAYS=30
MHA_RAG_TOP_K=3

# vivo 验证入口默认关闭。仅本地验证时启用，并自行生成高强度随机令牌。
# 真实 Android APP 上线前应改为用户身份令牌，不能把共享服务令牌写入安装包。
MHA_VIVO_SYNC_ENABLED=false
MHA_VIVO_SYNC_TOKEN=
# 仅管理员生成/撤销一次性设备绑定码使用；不要下发到 Android App。
MHA_VIVO_ENROLLMENT_ADMIN_TOKEN=
